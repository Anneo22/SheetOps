# Dependencies
node_modules/

# Claude<>Codex hand-off journal (can carry cross-project data from other Sheets
# operated via this CLI, e.g. a private finance workbook; never publish)
CHANGES.log

# Per-user project data (contains spreadsheet IDs, tokens, personal data)
projects/

# Runtime logs
logs/

# User-specific config (contains spreadsheet IDs and registered projects)
sheetops.config.json

# OAuth credentials (NEVER commit)
~/.sheetops-creds.json
.sheetops-creds.json
*-creds.json

# Clasp credentials
.clasprc.json

# Plugin build artifact (binary zip)
*.plugin

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Test scripts
test-*.sh
check-*.sh
*.sh

# Temp files
*.tmp
*.bak

# Agent protocol lives in CLAUDE.md; this local copy is untracked (publish-audit: process-file)
AGENTS.md
